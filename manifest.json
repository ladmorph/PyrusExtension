{
  "manifest_version": 3,
  "name": "Pyrus — перенос полей",
  "version": "0.9.9",
  "description": "Перенос полей между задачами одного шаблона в один шаг на черновике.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Перенос полей Pyrus"
  },
  "minimum_chrome_version": "102",
  "background": {
    "service_worker": "background.js"
  }
}
